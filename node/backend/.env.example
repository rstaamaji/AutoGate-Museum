# ── Node Identity ──
NODE_ID=node-gerbang-depan
NODE_NAME=Gerbang Depan

# ── SQLite ──
SQLITE_DB_PATH=./data/local.db

# ── Kamera MASUK ──
CAMERA_IN_HOST=192.168.1.64
CAMERA_IN_USER=admin
CAMERA_IN_PASSWORD=
CAMERA_IN_CHANNEL=1
CAMERA_IN_USE_HTTPS=false

# ── Kamera KELUAR ──
CAMERA_OUT_HOST=192.168.1.65
CAMERA_OUT_USER=admin
CAMERA_OUT_PASSWORD=
CAMERA_OUT_CHANNEL=1
CAMERA_OUT_USE_HTTPS=false

# ── Kamera Umum ──
CAMERA_AUTH_TYPE=digest
CAMERA_TIMEOUT=10

# ── Unknown plate values (comma separated) ──
UNKNOWN_PLATE_VALUES=unknown,unknow,unrecognized,n/a,noplate,none,-

# ── Storage ──
STORAGE_DIR=./storage/captures
STORAGE_PUBLIC_PATH=/storage/captures

# ── Modbus Relay ──
MODBUS_HOST=192.168.1.200
MODBUS_PORT=502

# ── Server (sinkronisasi) ──
SERVER_URL=http://localhost:8000
SERVER_API_KEY=
SYNC_INTERVAL=30
HEARTBEAT_INTERVAL=60

# ── App ──
APP_HOST=0.0.0.0
APP_PORT=3000
NODE_API_KEY=
