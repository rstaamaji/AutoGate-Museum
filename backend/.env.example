# ==== Database (PostgreSQL) ====
DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/autogatedb

# ==== Kamera ANPR - shared/default (dipakai sebagai fallback kalau CAMERA_IN_*/CAMERA_OUT_* tidak diisi) ====
CAMERA_USER=admin
CAMERA_PASSWORD=changeme
CAMERA_USE_HTTPS=false
CAMERA_AUTH_TYPE=digest
CAMERA_TIMEOUT=10

# ==== Kamera MASUK (entry) ====
CAMERA_IN_HOST=192.168.1.65
CAMERA_IN_USER=admin
CAMERA_IN_PASSWORD=changeme
CAMERA_IN_CHANNEL=1
CAMERA_IN_USE_HTTPS=false

# ==== Kamera KELUAR (exit) ====
CAMERA_OUT_HOST=192.168.1.64
CAMERA_OUT_USER=admin
CAMERA_OUT_PASSWORD=changeme
CAMERA_OUT_CHANNEL=1
CAMERA_OUT_USE_HTTPS=false

# ==== Modbus Relay ====
MODBUS_HOST= 192.168.1.200
MODBUS_PORT=502

# Nilai plat yang dianggap "tidak terbaca" oleh kamera -> otomatis diabaikan (tidak disimpan)
UNKNOWN_PLATE_VALUES=unknown,unknow,unrecognized,unrecognised,n/a,noplate,none,-

# ==== Penyimpanan gambar hasil capture (foto plat + foto scene) ====
STORAGE_DIR=./storage/captures
# base URL publik yang dipakai FastAPI untuk expose gambar (lihat main.py -> StaticFiles)
STORAGE_PUBLIC_PATH=/storage/captures

# ==== App ====
APP_HOST=0.0.0.0
APP_PORT=8000
# Kosongkan API_KEY kalau tidak mau pakai proteksi header X-API-Key
API_KEY=
