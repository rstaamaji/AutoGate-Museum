# ==== Database (PostgreSQL) ====
DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/autogatedb

# ==== Kamera Hikvision ANPR ====
CAMERA_HOST=192.168.1.64
CAMERA_USER=admin
CAMERA_PASSWORD=changeme
CAMERA_CHANNEL=1
CAMERA_USE_HTTPS=false
CAMERA_AUTH_TYPE=digest
CAMERA_TIMEOUT=10

# ==== Penyimpanan gambar hasil capture ====
STORAGE_DIR=./storage/captures
# base URL publik yang dipakai FastAPI untuk expose gambar (lihat main.py -> StaticFiles)
STORAGE_PUBLIC_PATH=/storage/captures

# ==== App ====
APP_HOST=0.0.0.0
APP_PORT=8000
# Kosongkan API_KEY kalau tidak mau pakai proteksi header X-API-Key
API_KEY=
