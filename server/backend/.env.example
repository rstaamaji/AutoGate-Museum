# ── Database PostgreSQL ──
DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/autogatedb

# ── Auth (API key untuk node → server) ──
API_KEY=

# ── Storage (gambar dari node) ──
STORAGE_DIR=./storage/captures
STORAGE_PUBLIC_PATH=/storage/captures

# ── App ──
APP_HOST=0.0.0.0
APP_PORT=8000
