# ── Database PostgreSQL ──
DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/autogatedb

# ── Auth JWT ──
SECRET_KEY=change-me-to-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── Default Super Admin (seed saat startup pertama) ──
DEFAULT_ADMIN_USERNAME=superadmin
DEFAULT_ADMIN_PASSWORD=admin123

# ── Auth API key legacy (opsional) ──
API_KEY=

# ── Storage (gambar dari node) ──
STORAGE_DIR=./storage/captures
STORAGE_PUBLIC_PATH=/storage/captures

# ── App ──
APP_HOST=0.0.0.0
APP_PORT=8000
